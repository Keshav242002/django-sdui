# .env.example — template for all required environment variables.
# Copy this file to .env and fill in real values.
# NEVER put real secrets in this file — it IS committed to git.

DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_LOG_LEVEL=INFO

# PostgreSQL on 127.0.0.1:5433
DB_NAME=sdui_dev
DB_USER=sdui_user
DB_PASSWORD=your-db-password-here
DB_HOST=127.0.0.1
DB_PORT=5433

# Redis on 127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Sentry DSN (optional). Leave blank to disable error reporting entirely --
# the SDK no-ops with an empty/missing DSN. See master/phase/phase-7-monitoring/
# runbook.md for how to get one on the free tier.
SENTRY_DSN=
